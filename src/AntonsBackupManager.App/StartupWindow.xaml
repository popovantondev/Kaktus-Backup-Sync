<Window x:Class="AntonsBackupManager.App.StartupWindow" x:ClassModifier="internal"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:AntonsBackupManager.App"
 Title="Kaktus Backup &amp; Sync" Width="600" Height="340" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
 MouseLeftButtonDown="SkipIntro" KeyDown="SkipIntro" AutomationProperties.Name="Kaktus Backup &amp; Sync">
 <Border CornerRadius="24" Background="#F3F6FB" BorderBrush="#DBE4F0" BorderThickness="1" ClipToBounds="True">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="36,0,0,0">
    <TextBlock Text="Kaktus" FontFamily="Segoe UI" FontSize="43" FontWeight="SemiBold" Foreground="#14253D"/>
    <TextBlock Text="Backup &amp; Sync" FontFamily="Segoe UI" FontSize="22" Foreground="#1677FF" Margin="0,4,0,0"/>
    <Border Width="44" Height="4" Background="#9BC5FF" CornerRadius="2" HorizontalAlignment="Left" Margin="0,24,0,18"/>
    <TextBlock Text="5.2 · Preview" FontFamily="Segoe UI" FontSize="13" Foreground="#607087"/>
   </StackPanel>
   <Grid Grid.Column="1" Width="300" Height="300" VerticalAlignment="Center" ClipToBounds="True">
    <!-- The static pot conceals the growth seam; both layers use one source. -->
    <Grid>
     <Grid.Clip><GeometryGroup FillRule="Nonzero"><RectangleGeometry Rect="0,0,300,211"/><EllipseGeometry Center="150,216" RadiusX="56" RadiusY="7"/></GeometryGroup></Grid.Clip>
    <Image x:Name="GrowingCactus" Source="{x:Static local:Brand.Mascot}" Width="300" Height="300" RenderOptions.BitmapScalingMode="HighQuality">
     <Image.Clip><RectangleGeometry Rect="0,0,300,224"/></Image.Clip>
     <Image.RenderTransform><ScaleTransform x:Name="GrowthScale" ScaleX="0.12" ScaleY="0.12" CenterX="150" CenterY="224"/></Image.RenderTransform>
    </Image>
    </Grid>
    <Image Source="{x:Static local:Brand.Mascot}" Width="300" Height="300" RenderOptions.BitmapScalingMode="HighQuality">
     <Image.Clip><RectangleGeometry Rect="0,211,300,89"/></Image.Clip>
    </Image>
   </Grid>
  </Grid>
 </Border>
</Window>

